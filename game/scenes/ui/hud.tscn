[sub_resource type="Shader" id="Shader_static"]
code = "shader_type canvas_item;
// Screen static from the fried control chip. 0 is clear, 1 is heavy.
uniform float intensity : hint_range(0.0, 1.0) = 0.0;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
	vec2 cell = floor(FRAGCOORD.xy / 3.0);
	float t = floor(TIME * 24.0);
	float noise = hash(cell + t);
	// Rolling bands, like a badly tuned set.
	float band = smoothstep(0.85, 1.0, sin(FRAGCOORD.y * 0.02 + TIME * 3.0));
	float a = intensity * (0.45 * noise + 0.25 * band * noise);
	COLOR = vec4(vec3(noise), a);
}
"

[sub_resource type="ShaderMaterial" id="Mat_static"]
shader = SubResource("Shader_static")
shader_parameter/intensity = 0.0

[node name="HUD" type="CanvasLayer"]
